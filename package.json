    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "exceljs": "^4.4.0",
    "fast-formula-parser": "^1.0.19",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "roughjs": "^4.6.6",
    "three": "^0.186.1",
