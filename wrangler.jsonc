// Static site only: Wrangler uploads the already built dist/ folder (with its _headers and _redirects) and runs no worker code.
// Having this file stops `wrangler deploy` from auto-configuring the project, which added @cloudflare/vite-plugin and broke the prerender build.
{
  "name": "openanydoc",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
